# ==============================================================
#  Spin Coater — root .gitignore
# ==============================================================

# --- STM32 / Keil MDK-ARM build output ---
stm32f103c8/MDK-ARM/Objects/
stm32f103c8/MDK-ARM/Listings/
stm32f103c8/MDK-ARM/DebugConfig/
*.uvguix.*
*.uvoptx
*.scvd
*.iex
*.axf
*.sct
*.dep
*.lnp
*.build_log.htm
*.htm

# --- ESP32 / PlatformIO build output ---
.pio/
esp32_s3_hmi/.pio/

# --- Compiled objects / firmware images ---
*.o
*.obj
*.elf
*.hex
*.bin
*.map
*.lst
*.d

# --- Debug files ---
*.dbg
*.pdbs

# --- Videos (demo goes to GitHub Releases, not the repo) ---
*.mp4
*.mov
*.avi
*.mkv

# --- IDE / editor ---
# Keep committed .vscode config (incl. the custom esp32-s3-n16r8v board
# definition needed for the PlatformIO build); ignore only the noisy files.
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/
.idea/
*.swp
*.swo
*~

# --- OS generated ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs / temp / backup ---
*.log
*.bak
*.old
build/
dist/
output/
